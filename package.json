{
  "name": "x402-api-portfolio",
  "version": "1.0.0",
  "private": true,
  "description": "x402 API portfolio plus a STDIO MCP server that pays USDC on Base for scraped-data tool calls.",
  "keywords": [
    "mcp",
    "modelcontextprotocol",
    "x402",
    "stdio"
  ],
  "license": "ISC",
  "main": "dist/mcp-server.js",
  "bin": {
    "x402-mcp": "dist/mcp-server.js"
  },
  "files": [
    "dist/mcp-server.js",
    "dist/x402-paid-fetch.js",
    "mcp.json",
    "mcp-config.json",
    "smithery.yaml"
  ],
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "dev": "ts-node-dev --respawn src/server.ts",
    "build": "tsc -p tsconfig.json",
    "start": "node dist/server.js",
    "generate:spec": "node scripts/generate-spec.js",
    "validate:spec": "node scripts/generate-spec.js --check",
    "auto-submit:registries": "node scripts/auto-submit-registries.js",
    "mcp": "node dist/mcp-server.js",
    "build:all": "npm run build --workspace @x402/x402-middleware && npm run build --workspace @x402/service-runtime && npm run build --workspaces --if-present && npm run build",
    "dev:alpharoute": "npm run dev --workspace @x402/alpharoute",
    "dev:sentinelfeed": "npm run dev --workspace @x402/sentinelfeed",
    "dev:complyrail": "npm run dev --workspace @x402/complyrail",
    "dev:distillforge": "npm run dev --workspace @x402/distillforge",
    "dev:proofmesh": "npm run dev --workspace @x402/proofmesh",
    "smoke": "tsx scripts/smoke-test.ts",
           "publish-smithery": "smithery mcp publish ./server.mcpb -n @dheeraj1018279/x402-api"


       

  },
  "workspaces": [
    "services/*",
    "shared/*"
  ],
  "author": "",
  "dependencies": {
    "@coinbase/cdp-sdk": "^1.55.0",
    "axios": "1.16.0",
    "@modelcontextprotocol/sdk": "^1.30.0",
    "@octokit/rest": "^22.0.1",
    "@x402/core": "^2.25.0",
    "@x402/evm": "^2.25.0",
    "@x402/express": "^2.25.0",
    "@x402/extensions": "^2.25.0",
    "@x402/fetch": "^2.25.0",
    "dotenv": "^17.4.2",
    "express": "^5.2.1",
    "viem": "^2.55.16",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@types/express": "^5.0.6",
    "@types/node": "^26.2.0",
    "ts-node-dev": "^2.0.0",
    "tsx": "^4.19.0",
    "typescript": "^5.9.3"
  }
}
